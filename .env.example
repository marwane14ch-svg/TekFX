# Gemini Multimodal API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Multimodal Model (Default: gemini-3.8-flash, with automatic fallback)
GEMINI_MODEL=gemini-3.8-flash

# TradingView Chart URL to capture (supports custom indicators, layout, symbol)
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/?symbol=BINANCE:BTCUSDT

# Dashboard Server Port
PORT=3000

# Email Alerts Configuration
# Recipient email address to receive analysis reports (scheduled & manual runs)
ALERT_EMAIL_RECIPIENT=marwane19ch@gmail.com

# SMTP Credentials (e.g. Gmail: your Gmail address & 16-character App Password)
SMTP_USER=
SMTP_PASS=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
