# Discord Webhook URL for automated analysis broadcasts (both manual and scheduled)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/1555372945415733259/DG8wWjJlgdjJcjcf-rosdDi7R0wArU4PdhlxFhEnNmz0QbUdr-qspJs6NmAvdNEz4QAV

# Dashboard Server Port
