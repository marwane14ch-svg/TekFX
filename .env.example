# Gemini Multimodal API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Multimodal Model (Default: gemini-3.8-flash, with automatic fallback)
GEMINI_MODEL=gemini-3.8-flash

# TradingView Chart URL to capture (supports custom indicators, layout, symbol)
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/?symbol=BINANCE:BTCUSDT

# Dashboard Server Port
PORT=3000

# WhatsApp Automated Alerts
WHATSAPP_PHONE=+212648863582

# Option 1: CallMeBot (Free personal WhatsApp API - Recommended)
# Send "I allow callmebot to send me messages" to +34 644 44 20 84 on WhatsApp to receive your API key
CALLMEBOT_API_KEY=

# Option 2: Twilio WhatsApp API
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_WHATSAPP_NUMBER=whatsapp:+14155238886
