# Gemini Multimodal API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# Gemini Multimodal Model (Default: gemini-3.8-flash, with automatic fallback)
GEMINI_MODEL=gemini-3.8-flash

# TradingView Chart URL to capture (supports custom indicators, layout, symbol)
TRADINGVIEW_CHART_URL=https://www.tradingview.com/chart/?symbol=BINANCE:BTCUSDT

# Discord Webhook URL for automated analysis broadcasts (both manual and scheduled)
DISCORD_WEBHOOK_URL=your_discord_webhook_url_here

# Dashboard Server Port
PORT=3000
